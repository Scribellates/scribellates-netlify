<section class="articles-grid-section">
  <h1 class="articles-grid-title">Posts</h1>

  <div class="articles-tag-filter js-articles-tag-filter" hidden>
    <p class="articles-tag-filter-label">Filtrer par tag</p>
    <div class="articles-tag-filter-buttons js-articles-tag-filter-buttons" role="group" aria-label="Filtres de tags"></div>
  </div>

  <div class="articles-card-grid js-articles-card-grid">
    {% for article in collections.articlesByPublication %}
      {% set articleTags = article.data.tagsArticle or [] %}
      <a href="{{ article.url }}" class="card card-article">
        <div class="card-article-body js-article-card" data-tags="{{ articleTags | join('|') }}">
          <h2 class="card-article-title">{{ article.data.titre }}</h2>
          <p class="card-article-excerpt">{{ article.templateContent | excerptFromMarkdown(165) }}</p>
          {% if articleTags.length %}
            <ul class="card-article-tags" aria-label="Tags de l'article">
              {% for tag in articleTags %}
                <li class="card-article-tag">{{ tag }}</li>
              {% endfor %}
            </ul>
          {% endif %}
          <p class="card-article-meta">
            <span>{{ article.data.datePublication | dateFormat }}</span>
            <span>{{ article.data.redacteur }}</span>
          </p>
        </div>
      </a>
    {% endfor %}
  </div>

  <nav
    class="listing-pagination js-listing-pagination"
    aria-label="Pagination des posts"
    data-initial-page="{{ pagination.pageNumber + 1 }}"
    hidden
  ></nav>

  <p class="articles-empty-state js-articles-empty-state" hidden>Aucun article ne correspond au tag selectionne.</p>
</section>

<script>
  (() => {
    const filterBlock = document.querySelector('.js-articles-tag-filter');
    const filterButtonsHost = document.querySelector('.js-articles-tag-filter-buttons');
    const cards = Array.from(document.querySelectorAll('.js-article-card'));
    const emptyState = document.querySelector('.js-articles-empty-state');
    const pagination = document.querySelector('.js-listing-pagination');

    if (!filterBlock || !filterButtonsHost || cards.length === 0) {
      return;
    }

    const parsedCards = cards.map((card) => {
      const tags = (card.dataset.tags || '')
        .split('|')
        .map((tag) => tag.trim())
        .filter(Boolean);

      return {
        wrapper: card.closest('.card-article'),
        tags,
      };
    });

    const orderedUniqueTags = [];
    for (const item of parsedCards) {
      for (const tag of item.tags) {
        if (!orderedUniqueTags.some((entry) => entry.toLowerCase() === tag.toLowerCase())) {
          orderedUniqueTags.push(tag);
        }
      }
    }

    filterBlock.hidden = orderedUniqueTags.length === 0;

    const queryTag = new URLSearchParams(window.location.search).get('tag');
    let activeTag = queryTag ? queryTag.trim().toLowerCase() : 'all';
    const pagePathMatch = window.location.pathname.match(/\/page\/(\d+)(?:\/index\.html)?\/?$/);
    const initialPage = Number(pagination.dataset.initialPage) || 1;
    let currentPage = pagePathMatch ? Number(pagePathMatch[1]) : initialPage;
    const basePath = window.location.pathname
      .replace(/\/page\/\d+(?:\/index\.html)?\/?$/, '/')
      .replace(/index\.html$/, '')
      .replace(/\/?$/, '/');

    const buttonMap = new Map();

    const setActiveButton = (key) => {
      for (const [buttonKey, button] of buttonMap.entries()) {
        button.classList.toggle('articles-tag-filter-button--active', buttonKey === key);
      }
    };

    const pageHref = (page) => {
      const pagePath = page === 1 ? basePath : `${basePath}page/${page}/`;
      const params = new URLSearchParams(window.location.search);

      if (activeTag === 'all') {
        params.delete('tag');
      } else {
        params.set('tag', activeTag);
      }

      const newSearch = params.toString();
      return `${pagePath}${newSearch ? `?${newSearch}` : ''}${window.location.hash}`;
    };

    const updateUrl = () => {
      window.history.replaceState({}, '', pageHref(currentPage));
    };

    const createPageLink = (label, page) => {
      const link = document.createElement('a');
      link.className = 'listing-pagination-link';
      link.href = pageHref(page);
      link.textContent = label;
      return link;
    };

    const createDisabledPageLabel = (label) => {
      const text = document.createElement('span');
      text.className = 'listing-pagination-link listing-pagination-link--disabled';
      text.textContent = label;
      text.setAttribute('aria-disabled', 'true');
      return text;
    };

    const renderPagination = (totalPages) => {
      pagination.replaceChildren();
      pagination.hidden = totalPages <= 1;

      if (pagination.hidden) {
        return;
      }

      const links = document.createElement('div');
      links.className = 'listing-pagination-links';
      links.append(
        currentPage > 1
          ? createPageLink('Precedent', currentPage - 1)
          : createDisabledPageLabel('Precedent')
      );

      const status = document.createElement('span');
      status.className = 'listing-pagination-status';
      status.textContent = `Page ${currentPage} sur ${totalPages}`;
      links.append(status);

      links.append(
        currentPage < totalPages
          ? createPageLink('Suivant', currentPage + 1)
          : createDisabledPageLabel('Suivant')
      );

      pagination.append(links);
    };

    const render = () => {
      const matchingCards = parsedCards.filter((item) =>
        activeTag === 'all' || item.tags.some((tag) => tag.toLowerCase() === activeTag)
      );
      const pageSize = window.matchMedia('(max-width: 640px)').matches ? 8 : 12;
      const totalPages = Math.max(1, Math.ceil(matchingCards.length / pageSize));
      currentPage = Math.min(Math.max(currentPage, 1), totalPages);

      const firstVisibleIndex = (currentPage - 1) * pageSize;
      const visibleCards = new Set(matchingCards.slice(firstVisibleIndex, firstVisibleIndex + pageSize));

      for (const item of parsedCards) {
        if (!item.wrapper) {
          continue;
        }

        const isVisible = visibleCards.has(item);
        item.wrapper.hidden = !isVisible;
        item.wrapper.style.display = isVisible ? '' : 'none';
      }

      emptyState.hidden = matchingCards.length > 0;
      renderPagination(totalPages);
      updateUrl();
    };

    const createButton = (label, key) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'articles-tag-filter-button';
      button.textContent = label;
      button.dataset.tag = key;
      button.addEventListener('click', () => {
        activeTag = key;
        currentPage = 1;
        setActiveButton(key);
        render();
      });

      buttonMap.set(key, button);
      filterButtonsHost.appendChild(button);
    };

    createButton('Tous', 'all');
    for (const tag of orderedUniqueTags) {
      createButton(tag, tag.toLowerCase());
    }

    if (!buttonMap.has(activeTag)) {
      activeTag = 'all';
    }

    const mobileLayout = window.matchMedia('(max-width: 640px)');
    mobileLayout.addEventListener('change', render);

    setActiveButton(activeTag);
    render();
  })();
</script>
