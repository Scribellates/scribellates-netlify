<section class="hero">
  <div class="hero-container">
    <div class="hero-content">
      <h1 class="hero-title">
        <span class="hero-title-line">{{ presentation.titre }}</span>
      </h1>
      <p class="hero-text">{{ presentation.texte }}</p>
      <div class="hero-actions">
        <a href="/manifeste" class="hero-btn-primary">
          <i class="fas fa-users"></i>
          Notre Manifeste
          <i class="fas fa-users"></i>
        </a>
      </div>
    </div>
    <div class="hero-image-wrapper">
      <div class="hero-image-container">
        <img 
          src="{{ presentation.image }}" 
          alt="{{ presentation.imageAlt }}" 
          class="hero-image"
          loading="lazy"
        />
        <div class="hero-image-glow"></div>
      </div>
    </div>
  </div>
</section>